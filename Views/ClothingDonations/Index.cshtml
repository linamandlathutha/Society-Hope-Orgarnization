@model IEnumerable<SocietyHopeOrg.Models.ClothingDonation>

@{
    ViewData["Title"] = "Clothing Donations";
}
@if (User.Identity.IsAuthenticated && (User.IsInRole("Admin")))
{
    <h1>Clothing Donations</h1>
    <form asp-action="Index" method="get" class="form-inline mb-3">
        <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="Search by Email" />
        <button type="submit" class="btn btn-primary ml-2">Search</button>
    </form>
}
<p>
    <a asp-action="Create" class="btn btn-primary">Create New Donation</a>
</p>

<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-4">
            <div class="card mb-4">
                <div class="card-body">
                    <h5 class="card-title">@item.FirstName @item.Surname</h5>
                    <p class="card-text"><strong>Email:</strong> @item.Email</p>
                    <p class="card-text"><strong>Phone Number:</strong> @item.PhoneNumber</p>
                    <p class="card-text"><strong>Tracking Code:</strong> @item.TrackingCode</p>
                    <p class="card-text"><strong>Clothing Type:</strong> @item.ClothType.ToString().Replace("_", " ")</p>
                    <p class="card-text"><strong>Size:</strong> @item.Size</p>
                    @if (User.Identity.IsAuthenticated && (User.IsInRole("Admin")))
                    {

                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-action="EditTrackingCode" asp-route-id="@item.Id" class="btn btn-primary btn-sm">Update Tracking Code</a>
                          
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
