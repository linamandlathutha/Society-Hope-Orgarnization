@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

<html lang="en">
<head>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <title>SHO</title>

    <link href="//fonts.googleapis.com/css2?family=DM+Sans:wght@400;700&display=swap" rel="stylesheet">

    <!-- Template CSS -->
    <link rel="stylesheet" href="~/css/Style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">

</head>
<body>
    <style>
        .fa-heart {
    color: red; /* Change to your preferred color */
    margin-right: 5px; /* Adjust the spacing as needed */
}

.mr {
    margin-right: 0.25rem;
}

        /* Show main dropdown on hover */
        .nav-item.dropdown:hover > .dropdown-menu {
            display: block; /* Show the main dropdown */
        }

        /* Basic styling for dropdown menus */
        .dropdown-menu {
            display: none; /* Hide dropdown menus by default */
            position: absolute;
            top: 100%; /* Position below the main item */
            left: 0;
            z-index: 1000;
            float: left;
            min-width: 10rem;
            padding: 0.5rem 0;
            margin: 0;
            font-size: 1rem;
            color: #212529;
            text-align: left;
            list-style: none;
            background-color: #fff;
            background-clip: padding-box;
            border: 1px solid rgba(0, 0, 0, 0.15);
            border-radius: 0.25rem;
        }

        /* Nested submenu styling */
        .dropdown-submenu {
            position: relative; /* Required for positioning the nested menu */
        }

            /* Hide nested dropdown by default */
            .dropdown-submenu .dropdown-menu {
                top: 0;
                left: 100%; /* Align the submenu to the right */
                margin-top: -1px; /* Aligns the submenu with the parent item */
                display: none; /* Hide submenu initially */
            }

            /* Show nested dropdown on hover of the parent */
            .dropdown-submenu:hover > .dropdown-menu {
                display: block; /* Show the submenu on hover */
            }



    </style>
    <!--header-->
    <header id="site-header" class="fixed-top">
        <div class="container">
            <nav class="navbar navbar-expand-lg stroke">
