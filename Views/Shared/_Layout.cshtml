                                    <a class="dropdown-item" asp-controller="Profile" asp-action="Index">View Profile</a>
                                </div>
                            </li>

                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="servicesDropdown" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                    Services
                                </a>
                                <div class="dropdown-menu" aria-labelledby="servicesDropdown">

                                    <div class="dropdown-submenu">
                                        <a class="dropdown-item dropdown-toggle" href="#">Donate Items</a>
                                        <div class="dropdown-menu">
                                            <a class="dropdown-item" asp-controller="GroceryDonation" asp-action="Create">Food Donations</a>
                                            <a class="dropdown-item" asp-controller="ClothingDonations" asp-action="Create">Donate Clothes</a>
                                            <a class="dropdown-item" asp-controller="ToysDonation" asp-action="Create">Donate Toys</a>
                                        </div>
                                    </div>



                                    <div class="dropdown-submenu">
                                        <a class="dropdown-item dropdown-toggle" href="#">List Donated Items</a>
                                        <div class="dropdown-menu">
                                            <a class="dropdown-item" asp-controller="GroceryDonation" asp-action="Index">Food Donations</a>
                                            <a class="dropdown-item" asp-controller="ClothingDonations" asp-action="Index">Donated Clothes</a>
                                            <a class="dropdown-item" asp-controller="ToysDonation" asp-action="Index">Donated Toys</a>
                                            <a class="dropdown-item" asp-controller="Donations" asp-action="Index"> Money Donations</a>

                                        </div>
                                    </div>

                                </div>
                            </li>


                        }
                        @if (User.Identity.IsAuthenticated && (User.IsInRole("Admin")))
                        {



                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="servicesDropdown" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                    Services
                                </a>
                                <div class="dropdown-menu" aria-labelledby="servicesDropdown">

                                    <div class="dropdown-submenu">
                                        <a class="dropdown-item dropdown-toggle" href="#">Donate Items</a>
                                        <div class="dropdown-menu">
                                            <a class="dropdown-item" asp-controller="GroceryDonation" asp-action="CreateAdmin">Food Donations</a>
                                            <a class="dropdown-item" asp-controller="ClothingDonations" asp-action="CreateAdmin">Donate Clothes</a>
                                            <a class="dropdown-item" asp-controller="ToysDonation" asp-action="CreateAdmin">Donate Toys</a>

                                        </div>
                                    </div>
                                    <div class="dropdown-submenu">
                                        <a class="dropdown-item dropdown-toggle" href="#">Beneficiaries</a>
                                        <div class="dropdown-menu">
                                            <a class="dropdown-item" asp-controller="Beneficiaries" asp-action="Create">Add Beneficiary</a>
                                            <a class="dropdown-item" asp-controller="Beneficiaries" asp-action="Index">List Beneficiaries</a>
                                            <a class="dropdown-item" asp-controller="User" asp-action="Index">List Users</a>
                                        </div>
                                    </div>





                                    <div class="dropdown-submenu">
                                        <a class="dropdown-item dropdown-toggle" href="#">List Donated Items</a>
                                        <div class="dropdown-menu">
                                            <a class="dropdown-item" asp-controller="GroceryDonation" asp-action="Index">Food Donations</a>
                                            <a class="dropdown-item" asp-controller="ClothingDonations" asp-action="Index">Donate Clothes</a>
                                            <a class="dropdown-item" asp-controller="ToysDonation" asp-action="Index">Donate Toys</a>
                                            <a class="dropdown-item" asp-controller="Donations" asp-action="Index"> Money Donations</a>
                                        </div>
                                    </div>
                                </div>
                            </li>


                        }
                      
                      
                        @if (User.Identity.IsAuthenticated && !(User.IsInRole("Admin")))
                        {
                            <li class="align-self">
                                <a asp-action="CreateSession" asp-controller="Donations" class="btn btn-style btn-primary ml-lg-3 mr-lg-2"><span class="fa fa-heart mr-1"></span> Donate</a>
                            </li>
                        }
                        <partial name="_LoginPartial" />
                    </ul>
                </div>
                <!-- toggle switch for light and dark theme -->
                <div class="mobile-position">
                    <nav class="navigation">
