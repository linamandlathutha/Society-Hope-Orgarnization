@model SocietyHopeOrg.Models.Donation

<h2>Make a Donation</h2>


<br />


<form asp-action="CreateSession" method="post">
    <div class="form-group">
        <label asp-for="DonorEmail"></label>
        <input asp-for="DonorEmail" class="form-control" />
        <span asp-validation-for="DonorEmail" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Amount"></label>
        <input asp-for="Amount" class="form-control" />
        <span asp-validation-for="Amount" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="DonorMessage"></label>
        <textarea asp-for="DonorMessage" class="form-control"></textarea>
        <span asp-validation-for="DonorMessage" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Donate</button>
</form>