
@model SocietyHopeOrg.Models.InvoiceViewModel

<!DOCTYPE html>
<html>
<head>
    <title>Invoice</title>
    <style>
        /* Add your styles here */
        body {
            font-family: Arial, sans-serif;
        }
        .header {
            text-align: center;
            margin-bottom: 20px;
        }
        .details {
            margin: 20px;
        }
        .footer {
            text-align: center;
            margin-top: 30px;
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>Invoice</h1>
        <h2>@Model.OrganizationName</h2>
    </div>
    <div class="details">
        <p><strong>Donor Name:</strong> @Model.DonorName</p>
        <p><strong>Email:</strong> @Model.Email</p>
        <p><strong>Donation Amount:</strong> @Model.Amount</p>
        <p><strong>Date:</strong> @Model.DonationDate.ToString("d")</p>
        <p><strong>Transaction ID:</strong> @Model.TransactionId</p>
    </div>
    <div class="footer">
        <p>Thank you for your generous donation!</p>
    </div>
</body>
</html>
