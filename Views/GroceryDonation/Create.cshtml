@model SocietyHopeOrg.Models.GroceryDonation 

@{
    ViewData["Title"] = "Create Grocery Donation";
}

<h1>Create Grocery Donation</h1>

<form asp-action="Create" method="post">
    <div class="form-group">
        <label asp-for="FirstName"></label>
        <input asp-for="FirstName" class="form-control" readonly="@(!User.IsInRole("Admin"))" />
    </div>
    <div class="form-group">
        <label asp-for="Surname"></label>
        <input asp-for="Surname" class="form-control" readonly="@(!User.IsInRole("Admin"))" />
    </div>
    <div class="form-group">
        <label asp-for="Email"></label>
        <input asp-for="Email" class="form-control" readonly="@(!User.IsInRole("Admin"))" />
    </div>
    <div class="form-group">
        <label asp-for="PhoneNumber"></label>
        <input asp-for="PhoneNumber" class="form-control" readonly />
        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label>Canned Food Quantity:</label>
        <input type="number" asp-for="CannedFoodQuantity" class="form-control" min="0" />
    </div>
    <div class="form-group">
        <label>Beans Quantity:</label>
        <input type="number" asp-for="BeansQuantity" class="form-control" min="0" />
    </div>
    <div class="form-group">
        <label>Pasta or Rice Quantity:</label>
        <input type="number" asp-for="PastaOrRiceQuantity" class="form-control" min="0" />
    </div>
    <div class="form-group">
        <label>Sugar, Flour, Salt, Condiments Quantity:</label>
        <input type="number" asp-for="SugarFlourSaltCondimentsQuantity" class="form-control" min="0" />
    </div>
    <div class="form-group">
        <label>Baby Products Quantity:</label>
        <input type="number" asp-for="BabyProductsQuantity" class="form-control" min="0" />
    </div>

    <button type="submit" class="btn btn-primary">Create</button>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
