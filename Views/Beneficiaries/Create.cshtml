@model SocietyHopeOrg.Models.Beneficiary

<h2>Add Beneficiary</h2>
<style>
    form {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .form-control {
        border: 1px solid #ccc;
        border-radius: 8px;
        padding: 10px;
        width: 100%;
        max-width: 500px; /* Adjust the max width as needed */
        margin-bottom: 15px;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
    }

    .form-group {
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    button {
        border-radius: 8px;
        padding: 10px 20px;
        background-color: #005655;
        color: white;
        border: none;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
    }

    .custom-checkbox .form-check-input {
        width: 20px;
        height: 20px;
        border: 2px solid #005655;
        background-color: #fff;
    }

        .custom-checkbox .form-check-input:checked {
            background-color: #005655;
        }

    .custom-checkbox .form-check-label {
        margin-left: 25px;
    }

    h2 {
        text-align: center;
    }

    .custom-checkbox .form-check-input {
        width: 20px;
        height: 20px;
        border: 2px solid #005655; /* Customize the border color */
        background-color: #fff; /* Background color */
    }

        .custom-checkbox .form-check-input:checked {
            background-color: #005655; /* Background color when checked */
        }

    .custom-checkbox .form-check-label {
        margin-left: 25px; /* Space between checkbox and label */
    }

</style>
<form asp-action="Create" method="post">
    <br />
    <br />
    <div class="form-group">
        <label asp-for="BeneName"></label>
        <input asp-for="BeneName" class="form-control" />
        <span asp-validation-for="BeneName" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="BeneSurname"></label>
        <input asp-for="BeneSurname" class="form-control" />
        <span asp-validation-for="BeneSurname" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="BeneficiaryID"></label>
        <input asp-for="BeneficiaryID" class="form-control" />
        <span asp-validation-for="BeneficiaryID" class="text-danger"></span>
    </div>
    <div class="form-group custom-checkbox">
        <div class="form-check">
            <input asp-for="IsMale" class="form-check-input" type="checkbox" />
            <label asp-for="IsMale" class="form-check-label"></label>
        </div>
        <span asp-validation-for="IsMale" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="BeneReasons"></label>
        <select asp-for="BeneReasons" class="form-control">
            @foreach (var service in Enum.GetValues(typeof(BeneReason)).Cast<BeneReason>())
            {
                <option value="@service">@service</option>
            }
        </select>
        <span asp-validation-for="BeneReasons" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="DateOfBirth"></label>
        <input asp-for="DateOfBirth" class="form-control" type="date" />
        <span asp-validation-for="DateOfBirth" class="text-danger"></span>
    </div>
    
    <div class="form-group">
        <label asp-for="ContactNumber"></label>
        <input asp-for="ContactNumber" class="form-control" />
        <span asp-validation-for="ContactNumber" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Address"></label>
        <input asp-for="Address" class="form-control" id="Address" />
        <span asp-validation-for="Address" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
</form>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script src="https://maps.googleapis.com/maps/api/js?key=@ViewBag.GoogleApiKey&libraries=places"></script>


    <script>

        // Initialize Google Places Autocomplete for address input
        function initialize() {
            var input = document.getElementById('Address');
            var autocomplete = new google.maps.places.Autocomplete(input);
            autocomplete.setFields(['address_components', 'formatted_address']);
        }
        google.maps.event.addDomListener(window, 'load', initialize);



        // Function to generate a random case number
        function generateRandomCode(length) {
            var characters = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
            var code = '';
            for (var i = 0; i < length; i++) {
                var randomIndex = Math.floor(Math.random() * characters.length);
                code += characters.charAt(randomIndex);
            }
            return code;
        }

        document.addEventListener('DOMContentLoaded', function () {
            var caseNumber = generateRandomCode(13); // Adjust the length as needed
            document.getElementById('caseNumberField').value = caseNumber;
        });
    </script>
}
