@model IEnumerable<Beneficiary>

@{
    ViewData["Title"] = "Index";
}

<h1>Beneficiary List</h1>
<form asp-action="Index" method="get" class="form-inline mb-3">
    <input type="text" name="searchString" class="form-control" placeholder="Search by ID" />
    <button type="submit" class="btn btn-primary ml-2">Search</button>
</form>

<p>
    <a asp-action="Create">Create New</a>
</p>

<div class="card-container">
    @foreach (var item in Model)
    {
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">@item.BeneName @item.BeneSurname</h5>
                <p class="card-text">
                    <strong>ID:</strong> @item.BeneficiaryID<br />
                    <strong>Gender:</strong> @(item.IsMale ? "Male" : "Female")<br />
                    <strong>Reason:</strong> @item.BeneReasons<br />
                    <strong>Date of Birth:</strong> @item.DateOfBirth.ToString("yyyy-MM-dd")<br />
                    <strong>Contact:</strong> @item.ContactNumber<br />
                    <strong>Address:</strong> @item.Address
                </p>
                <a asp-action="Edit" asp-route-id="@item.BeneCount" class="btn btn-primary">Edit</a>
                <a asp-action="Details" asp-route-id="@item.BeneCount" class="btn btn-info">Details</a>
                <a asp-action="Delete" asp-route-id="@item.BeneCount" class="btn btn-danger">Delete</a>
            </div>
        </div>
    }
</div>
<style>
    .card-container {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 20px;
    }

    .card {
        width: 300px;
        border: 1px solid #ddd;
        border-radius: 8px;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
        margin: 20px;
    }

    .card-body {
        padding: 20px;
    }

    .card-title {
        font-size: 1.25rem;
        margin-bottom: 10px;
    }

    .card-text {
        font-size: 1rem;
        margin-bottom: 20px;
    }

    .btn {
        margin-right: 10px;
    }

</style>